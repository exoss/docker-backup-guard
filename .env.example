# --- Portainer API ---
PORTAINER_URL=
PORTAINER_TOKEN=

# --- Gotify Notifications ---
GOTIFY_URL=
GOTIFY_TOKEN=

# --- Backup Core ---
BACKUP_PASSWORD=
RETENTION_DAYS=7
TZ=Europe/Berlin
CUSTOM_BACKUP_PATH=

# --- Healthcheck (HC.io / Uptime Kuma) ---
HEALTHCHECK_URL=
VERIFY_SSL=false
HEARTBEAT_URL=
HEARTBEAT_INTERVAL=0

# --- Scheduler ---
SCHEDULE_ENABLE=false
SCHEDULE_TIME=03:00

# --- Web UI ---
WEB_UI_USERNAME=admin
WEB_UI_PASSWORD=admin

# --- Rclone ---
RCLONE_CONFIG_PATH=/app/rclone.conf
RCLONE_REMOTE_NAME=remote
RCLONE_DESTINATION=backups

# --- UI Language (en / tr / de) ---
LANGUAGE=en
